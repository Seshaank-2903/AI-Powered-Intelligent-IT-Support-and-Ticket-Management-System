APP_ENV=development
APP_NAME=company-ai-it-support
SECRET_KEY=your_super_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/company_ai_it_support

# Mistral AI configuration
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed

# ChromaDB configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_PREFIX=company_protocols

# Zulip Bot configuration
ZULIP_SITE=https://your-zulip-site.zulipchat.com
ZULIP_EMAIL=your-bot@your-zulip-site.zulipchat.com
ZULIP_API_KEY=your_zulip_api_key
ZULIP_AI_SUPPORT_STREAM=ai-support
ZULIP_IT_SUPPORT_STREAM=it-support
ZULIP_IT_ADMIN_STREAM=it-admin

# Frontend configuration
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
